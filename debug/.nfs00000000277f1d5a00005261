#!/bin/bash
set -euo pipefail

# Waits until a given nvidia-smi GPU index is free, then launches a run.py job.
# Usage: ./wait_for_gpu_and_run.sh <nvidia_smi_index> <poll_seconds> -- <run.py args...>
# Example (GPU 0 in run.py == nvidia-smi 7, the A100):
#   nohup ./wait_for_gpu_and_run.sh 7 60 -- train_final_xlmr_multilingual 0 > debug/wait_for_gpu7.log 2>&1 &

NVIDIA_SMI_INDEX="${1:?nvidia-smi GPU index required}"
POLL_SECONDS="${2:?poll interval in seconds required}"
shift 2
if [ "${1:-}" != "--" ]; then
    echo "expected -- before run.py args" >&2
    exit 1
fi
shift

MEM_THRESHOLD_MIB=500
consecutive_free=0
required_consecutive=2

while [ "$consecutive_free" -lt "$required_consecutive" ]; do
    used=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits -i "$NVIDIA_SMI_INDEX")
    if [ "$used" -lt "$MEM_THRESHOLD_MIB" ]; then
        consecutive_free=$((consecutive_free + 1))
        echo "$(date '+%F %T') GPU $NVIDIA_SMI_INDEX free (${used} MiB used), check $consecutive_free/$required_consecutive"
    else
        echo "$(date '+%F %T') GPU $NVIDIA_SMI_INDEX busy (${used} MiB used)"
        consecutive_free=0
        sleep "$POLL_SECONDS"
        continue
    fi
    [ "$consecutive_free" -lt "$required_consecutive" ] && sleep "$POLL_SECONDS"
done

echo "$(date '+%F %T') launching: python run.py $*"
exec python run.py "$@"
